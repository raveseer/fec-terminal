# Free key: https://api.data.gov/signup/ (1,000 req/hr; DEMO_KEY is ~30/hr)
FEC_API_KEY=your_key_here
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:8b

# --- Ask AI (agentic free-text Q&A about a candidate) ---
# The agent needs reliable tool-calling. Pull a tool-capable model and name it here.
#   ollama pull mistral-small3.2:latest   (recommended; strong tool-caller)
#   lighter options: llama3.1:8b, qwen2.5:14b
OLLAMA_TOOL_MODEL=mistral-small3.2:latest
# Web search provider for the agent. Default "tavily". Leave the key blank to run
# Ask AI on FEC/TN/Wikipedia/news only (no live web).
#   Tavily (free tier, easiest):  https://app.tavily.com/  -> SEARCH_PROVIDER=tavily
#   Brave:    https://brave.com/search/api/  -> SEARCH_PROVIDER=brave
#   SerpAPI:  https://serpapi.com/           -> SEARCH_PROVIDER=serpapi
SEARCH_PROVIDER=tavily
SEARCH_API_KEY=

# Uncomment to tune:
# OLLAMA_TIMEOUT_MS=600000
# CACHE_TTL_MS=300000
# FEC_FETCH_TIMEOUT_MS=20000
# SEARCH_CACHE_TTL_MS=3600000
